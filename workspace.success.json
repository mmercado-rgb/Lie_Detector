{
  "version": 2,
  "task_id": "report-generator-example",
  "goal": "Verify Codex created report_generator.py and it produces the required artifact",
  "inputs": {
    "repo_root": "."
  },
  "success_conditions": [
    {
      "id": "report-file-exists",
      "type": "file_exists",
      "path": "src/report_generator.py"
    },
    {
      "id": "report-generator-runs",
      "type": "command_exit_zero",
      "command": "python src/report_generator.py"
    },
    {
      "id": "smoke-black-box",
      "type": "verifier_stdout_contains",
      "command": "python scripts/smoke.py",
      "contains": "OK"
    }
  ],
  "evidence": {
    "output_dir": ".artifacts",
    "save_stdout": true,
    "save_stderr": true,
    "save_exit_codes": true,
    "hash_algorithm": "sha256",
    "freshness_path": ".truth/latest_run_id.txt"
  },
  "policy": {
    "fail_closed": true,
    "executor_cannot_claim_success": true,
    "verifier_is_final_authority": true,
    "require_black_box_verification": true,
    "reserved_outcome_words": [
      "PASS",
      "FAIL",
      "passed",
      "verified",
      "complete",
      "ready",
      "successful"
    ]
  }
}
