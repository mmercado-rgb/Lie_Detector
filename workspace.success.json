{
  "version": 2,
  "task_id": "experiment-energy-ledger",
  "goal": "Verify the experiment package implements deterministic energy-accounting behaviors described by the experiment README",
  "inputs": {
    "repo_root": "."
  },
  "success_conditions": [
    {
      "id": "experiment-package-file-exists",
      "type": "file_exists",
      "path": "experiment/__init__.py"
    },
    {
      "id": "experiment-batch-runner-file-exists",
      "type": "file_exists",
      "path": "experiment/batch_runner.py"
    },
    {
      "id": "experiment-package-imports",
      "type": "command_exit_zero",
      "command": "python -c \"from experiment import build_ledger, make_closed_run_data, make_result_record, run_batch, summarize_results\""
    },
    {
      "id": "experiment-results-schema-file-exists",
      "type": "file_exists",
      "path": "experiment/results_schema.py"
    },
    {
      "id": "experiment-analyze-runs-file-exists",
      "type": "file_exists",
      "path": "experiment/analyze_runs.py"
    },
    {
      "id": "experiment-run-batch-closed",
      "type": "command_exit_zero",
      "command": "python -c \"from experiment import make_closed_run_data, run_batch; out=run_batch([make_closed_run_data()], 1e-9); assert isinstance(out, list); assert len(out)==1; assert set(out[0].keys())=={'ledger','residual','label'}; assert out[0]['label']=='CLOSED'\""
    },
    {
      "id": "experiment-smoke-file-exists",
      "type": "file_exists",
      "path": "scripts/smoke.py"
    },
    {
      "id": "experiment-smoke-stored-energy",
      "type": "verifier_stdout_contains",
      "command": "python scripts/smoke.py",
      "contains": "stored_energy_example: 6.5"
    },
    {
      "id": "experiment-smoke-integrate-power",
      "type": "verifier_stdout_contains",
      "command": "python scripts/smoke.py",
      "contains": "integrate_power_example: 4.0"
    },
    {
      "id": "experiment-smoke-closed",
      "type": "verifier_stdout_contains",
      "command": "python scripts/smoke.py",
      "contains": "closed_system: residual=0.0, label=CLOSED"
    },
    {
      "id": "experiment-smoke-underaccounted",
      "type": "verifier_stdout_contains",
      "command": "python scripts/smoke.py",
      "contains": "underaccounted_energy: residual=1.0, label=UNDERACCOUNTED"
    },
    {
      "id": "experiment-smoke-apparent-excess",
      "type": "verifier_stdout_contains",
      "command": "python scripts/smoke.py",
      "contains": "apparent_excess_energy: residual=-1.0, label=APPARENT_EXCESS"
    },
    {
      "id": "experiment-smoke-run-to-ledger",
      "type": "verifier_stdout_contains",
      "command": "python scripts/smoke.py",
      "contains": "run_to_ledger_closed: residual=0.0, label=CLOSED"
    },
    {
      "id": "experiment-smoke-summary",
      "type": "verifier_stdout_contains",
      "command": "python scripts/smoke.py",
      "contains": "analyze_runs_mixed: total_runs=3, count_closed=1, count_underaccounted=1, count_apparent_excess=1"
    }
  ],
  "evidence": {
    "output_dir": ".artifacts",
    "save_stdout": true,
    "save_stderr": true,
    "save_exit_codes": true,
    "hash_algorithm": "sha256",
    "freshness_path": ".truth/latest_run_id.txt"
  },
  "policy": {
    "fail_closed": true,
    "executor_cannot_claim_success": true,
    "verifier_is_final_authority": true,
    "require_black_box_verification": true,
    "reserved_outcome_words": [
      "PASS",
      "FAIL",
      "passed",
      "verified",
      "complete",
      "ready",
      "successful"
    ]
  }
}
